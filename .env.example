# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase / RDS / docker-compose).
# For zero-install local dev you can run `npm run db:local` and use:
#   postgresql://postgres:postgres@127.0.0.1:5433/telegram_alerts
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_alerts

# ─── Auth ────────────────────────────────────────────────────────────────────
# HMAC key for hashing session tokens. Required in production. Generate with: openssl rand -base64 32
# (named NEXTAUTH_SECRET for compatibility; AUTH_SECRET is also accepted)
NEXTAUTH_SECRET=
# Public base URL of the app (used for origin checks and links)
APP_URL=http://localhost:3000
# Personal installation: sign-up is open only until the owner account exists.
# Set to true to temporarily allow creating another account.
ALLOW_REGISTRATION=
# password (default): sign-in required.
# local: no sign-in when you open http://localhost on this computer. Only takes effect when the app is
#        started with `npm run dev` or `npm run start:local`, which listen on 127.0.0.1 only (other machines
#        cannot connect). Ignored for Docker, `npm start` and deployed servers — they always require sign-in.
AUTH_MODE=password

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte key, base64 encoded, used to encrypt Telegram bot tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# NEVER change this after bots are saved, or stored tokens become unreadable.
ENCRYPTION_KEY=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_API_URL=https://api.telegram.org

# ─── Queue (optional but recommended in production) ──────────────────────────
# When set, BullMQ + Redis are used for the Telegram queue and price polling scheduler.
# When empty, the worker falls back to polling the database outbox (fine for dev/small installs).
REDIS_URL=

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Global (operator) secret for POST /api/webhooks/price. Feeds the shared "webhook" price stream.
# Users can also create personal webhook API keys under Settings.
WEBHOOK_SECRET=

# Secret for the GET /api/cron/poll endpoint (Vercel Cron / external scheduler).
CRON_SECRET=

# ─── Market data ─────────────────────────────────────────────────────────────
# Default provider for new alerts: mock | twelvedata | binance | custom | webhook
#   mock       deterministic synthetic prices/candles (no key). Shown as SIMULATED, never as live data.
#   twelvedata real OHLC candles 1m–1M + prices (needs TWELVE_DATA_API_KEY)
#   webhook    prices or OHLC bars pushed by TradingView / your scripts (Settings → Webhooks)
# ("simulated" is accepted as an alias of "mock" for older alerts.)
MARKET_DATA_PROVIDER=mock
# Twelve Data API key (MARKET_DATA_API_KEY is accepted as a fallback name)
TWELVE_DATA_API_KEY=
# Twelve Data request budget per minute (free tier: 8). Shared across processes when Redis is set.
TWELVE_DATA_RATE_LIMIT_PER_MIN=8
# Custom REST provider: {symbol} is replaced. JSON path is dot-separated (e.g. data.price)
CUSTOM_PRICE_URL=
CUSTOM_PRICE_JSON_PATH=price
CUSTOM_PRICE_API_KEY_HEADER=

# Worker price polling interval (also the condition-engine cycle)
PRICE_POLL_INTERVAL_MS=5000
# A polled price older than this is STALE (default: 3 poll intervals, minimum 15000)
MARKET_DATA_MAX_AGE_MS=
# Candle freshness: a candle series is STALE when the next closed candle is overdue by more than this.
# Providers publish closed bars a few seconds after the boundary. Default 120000 (2 min), minimum 10000.
MARKET_DATA_CANDLE_GRACE_MS=120000

# ─── Notifications ───────────────────────────────────────────────────────────
# Delivery attempts before a notification becomes DEAD_LETTER (retried with backoff; Telegram 429 honoured)
TELEGRAM_MAX_RETRIES=6

# Log level: debug | info | warn | error
LOG_LEVEL=info
