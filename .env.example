# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase / RDS / docker-compose).
# For zero-install local dev you can run `npm run db:local` and use:
#   postgresql://postgres:postgres@127.0.0.1:5433/telegram_alerts
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telegram_alerts

# ─── Auth ────────────────────────────────────────────────────────────────────
# HMAC key for hashing session tokens. Required in production. Generate with: openssl rand -base64 32
# (named NEXTAUTH_SECRET for compatibility; AUTH_SECRET is also accepted)
NEXTAUTH_SECRET=
# Public base URL of the app (used for origin checks and links)
APP_URL=http://localhost:3000
# Personal installation: sign-up is open only until the owner account exists.
# Set to true to temporarily allow creating another account.
ALLOW_REGISTRATION=

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32-byte key, base64 encoded, used to encrypt Telegram bot tokens at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# NEVER change this after bots are saved, or stored tokens become unreadable.
ENCRYPTION_KEY=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_API_URL=https://api.telegram.org

# ─── Queue (optional but recommended in production) ──────────────────────────
# When set, BullMQ + Redis are used for the Telegram queue and price polling scheduler.
# When empty, the worker falls back to polling the database outbox (fine for dev/small installs).
REDIS_URL=

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Global (operator) secret for POST /api/webhooks/price. Feeds the shared "webhook" price stream.
# Users can also create personal webhook API keys under Settings.
WEBHOOK_SECRET=

# Secret for the GET /api/cron/poll endpoint (Vercel Cron / external scheduler).
CRON_SECRET=

# ─── Market data ─────────────────────────────────────────────────────────────
# Default provider for new alerts: simulated | binance | twelvedata | custom | webhook
DEFAULT_MARKET_DATA_PROVIDER=simulated
# API key for the provider that needs one (Twelve Data)
MARKET_DATA_API_KEY=
# Custom REST provider: {symbol} is replaced. JSON path is dot-separated (e.g. data.price)
CUSTOM_PRICE_URL=
CUSTOM_PRICE_JSON_PATH=price
CUSTOM_PRICE_API_KEY_HEADER=

# Worker price polling interval
PRICE_POLL_INTERVAL_MS=5000
# A polled price older than this is STALE (default: 3 poll intervals, minimum 15000)
MARKET_DATA_MAX_AGE_MS=

# Log level: debug | info | warn | error
LOG_LEVEL=info
